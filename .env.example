# Application
NEXT_PUBLIC_APP_NAME=HoodDesk
NEXT_PUBLIC_APP_URL=

# Network selection (4663 = mainnet, 46630 = testnet)
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Server RPC
ROBINHOOD_CHAIN_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_CHAIN_WS_URL=

# WalletConnect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Blockscout PRO API
BLOCKSCOUT_API_URL=https://robinhoodchain.blockscout.com/api/v2
BLOCKSCOUT_API_KEY=

# Database
DATABASE_URL=file:./dev.db

# RobinFun launchpad factories (comma-separated, current first)
ROBINFUN_FACTORIES=0xd861cb5DC71A0171E8F0f6586cADb069f3A35E4d,0x42B1f2Fb09502b66Ae21769b3384a7788d020d73,0x9A4a94Bd3aF6acF5567A3B22f264E08B0962B8c8,0xD69A9fDee44a42c8E614128FEda486128cB27222,0xD952A74C85a2221a7DaB185c62cfD7EBa8C94AFC

# Graduation DEX (Uniswap V2 style)
DEX_ADAPTER=robinfun-v2
DEX_FACTORY_ADDRESS=0x8bcEaA40B9AcdfAedF85AdF4FF01F5Ad6517937f
DEX_ROUTER_ADDRESS=0x89e5DB8B5aA49aA85AC63f691524311AEB649eba
DEX_QUOTER_ADDRESS=
WRAPPED_NATIVE_TOKEN_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73

# Contract allowlists (comma-separated, empty = only configured above)
ALLOWED_ROUTER_ADDRESSES=0x89e5DB8B5aA49aA85AC63f691524311AEB649eba
ALLOWED_FACTORY_ADDRESSES=0x8bcEaA40B9AcdfAedF85AdF4FF01F5Ad6517937f
ALLOWED_QUOTER_ADDRESSES=
ALLOWED_TOKEN_ADDRESSES=

# Token discovery (worker background job, read-only)
TOKEN_DISCOVERY_ENABLED=true
TOKEN_DISCOVERY_INTERVAL_MS=300000
TOKEN_DISCOVERY_CONCURRENCY=5

# Automated execution
EXECUTION_ENABLED=false
AUTOMATED_ORDERS_ENABLED=false
EXECUTION_PRIVATE_KEY=
EXECUTION_POLL_INTERVAL_MS=8000
EXECUTION_MAX_ATTEMPTS=3
EXECUTION_CONFIRMATIONS=1
EXECUTION_MIN_GAS_BALANCE_ETH=0.005
EXECUTION_MAX_GAS_GWEI=

# Safeguards
DEFAULT_SLIPPAGE_BPS=100
MAX_SLIPPAGE_BPS=500
MAX_PRICE_IMPACT_BPS=800
DEFAULT_TRANSACTION_DEADLINE_SECONDS=300
EMERGENCY_PAUSE=true
